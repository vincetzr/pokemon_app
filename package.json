{
  "name": "pokemon-card-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Scan, authenticate, and price Pokemon TCG cards from your phone camera.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "tsx scripts/snapshot-prices.ts",
    "bake": "tsx scripts/bake-offline.ts",
    "bake:catalogue": "tsx scripts/bake-tcgcsv.ts",
    "build:scanner": "node scripts/build-scanner.mjs",
    "dev:phone": "next dev --experimental-https -H 0.0.0.0",
    "backfill:history": "node scripts/backfill-tcgcsv-history.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "^13.0.3",
    "culori": "^4.0.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/culori": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
