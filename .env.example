# ---------------------------------------------------------------------------
# All keys below are OPTIONAL. The app runs without any of them — features that
# depend on a missing key are disabled and say so in the UI, rather than
# silently degrading or inventing data.
# ---------------------------------------------------------------------------

# Pokemon TCG API (https://dev.pokemontcg.io/).
# Without a key you are rate limited to a much lower request ceiling, which is
# usually fine for personal use but will throttle bulk scanning.
POKEMONTCG_API_KEY=

# Anthropic API (https://console.anthropic.com/).
# Enables the Claude vision signals: reading card identity from a photo, and the
# qualitative authenticity assessment. Without it, identification falls back to
# on-device OCR and the authenticity report omits the vision signal (and lowers
# its own confidence accordingly).
ANTHROPIC_API_KEY=

# PriceCharting (https://www.pricecharting.com/api-documentation).
# Enables backfilled historical pricing. Without it, price history is limited to
# the Cardmarket rolling averages plus whatever this app has recorded itself.
PRICECHARTING_API_TOKEN=

# Where the local price-snapshot database lives.
DATABASE_PATH=./data/prices.db
